{
  "name": "stock-analysis-toolkit",
  "version": "1.0.0",
  "description": "Bilingual stock analysis handbook and interactive lessons",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node tests/finance.test.js && node scripts/validate.mjs && node --test 'tools/calc/test/*.test.mjs' 'tools/agent/test/*.test.mjs'",
    "test:browser": "playwright test",
    "test:extract": "uv run --project tools/extract pytest tools/extract/tests -q",
    "sat": "node scripts/sat.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarvischer/stock-analysis-toolkit.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "ajv": "8.18.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
